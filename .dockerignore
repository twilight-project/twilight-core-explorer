# Keep the build context small + deterministic. Source is COPYied in; deps/build artifacts are
# (re)generated inside the image, and host-generated ones (esp. the Prisma client) must NOT leak in.
node_modules
**/node_modules
dist
**/dist
.next
**/.next
*.tsbuildinfo

.git
.gitignore

# never bake local env / secrets into an image. Patterns here are root-anchored (unlike .gitignore),
# so nested env files (e.g. apps/web/.env.local) need the **/ forms.
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.devnet.example
!**/.env.example
# Origin TLS material (Cloudflare Origin CA cert/key, §12 of the runbook) — `COPY . .` would bake it in
caddy/certs

# local-only / heavy / irrelevant to the build
reference
docs/research/artifacts
.claude
coverage
**/coverage
*.log
.DS_Store
.turbo
